# ============================================================
# INTELLI-CREDIT ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ============================================================

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=llama3.1:8b
OLLAMA_FINANCIAL_MODEL=mistral:7b
OLLAMA_STRUCTURED_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Qdrant Vector Store ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_FINANCIAL=financial_docs
QDRANT_COLLECTION_RESEARCH=research_docs
QDRANT_COLLECTION_LEGAL=legal_docs

# --- Neo4j Knowledge Graph ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=intellicredit2026

# --- PostgreSQL ---
DATABASE_URL=postgresql://intellicredit:password@localhost:5432/intellicredit_db

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379/0

# --- Web Research APIs ---
SERP_API_KEY=your_serpapi_key_here
NEWS_API_KEY=your_newsapi_key_here

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-super-secret-key-change-in-production

# --- Indian Context ---
MCA_BASE_URL=https://www.mca.gov.in/mcafoportal/
ECOURTS_BASE_URL=https://services.ecourts.gov.in/
RBI_BASE_URL=https://www.rbi.org.in/
SEBI_BASE_URL=https://www.sebi.gov.in/

# --- Scoring Thresholds ---
RISK_SCORE_HIGH_THRESHOLD=70
RISK_SCORE_MEDIUM_THRESHOLD=50
MAX_LOAN_TO_TURNOVER_RATIO=0.5
